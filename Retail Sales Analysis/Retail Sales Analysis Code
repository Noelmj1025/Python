import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import PolynomialFeatures, StandardScaler
from sklearn.metrics import mean_squared_error

# Load Dataset
try:
    df = pd.read_csv("sales_data_india 1.csv")
except FileNotFoundError:
    raise FileNotFoundError("The file 'sales_data_india.csv' was not found. Ensure the file is in the correct directory.")

# Data Cleaning and Preprocessing
if 'Order Date' not in df.columns or 'Quantity' not in df.columns or 'Sales (₹)' not in df.columns:
    raise ValueError("The dataset must contain 'Order Date', 'Quantity', and 'Sales (₹)' columns.")

# Convert dates with explicit `dayfirst=True`
df['Order Date'] = pd.to_datetime(df['Order Date'], errors='coerce', dayfirst=True)
df['Ship Date'] = pd.to_datetime(df['Ship Date'], errors='coerce', dayfirst=True)
df = df.dropna(subset=['Order Date', 'Ship Date'])  # Drop invalid dates
df.drop_duplicates(inplace=True)

# Calculate Total Sales
df['TotalSales'] = df['Quantity'] * df['Sales (₹)']

# Data Transformation
df['Year'] = df['Order Date'].dt.year
df['Month'] = df['Order Date'].dt.month
df['DayOfWeek'] = df['Order Date'].dt.day_name()

# 1. Monthly Sales Trend
monthly_sales = df.groupby(['Year', 'Month'])['TotalSales'].sum().reset_index()
monthly_sales['MonthYear'] = pd.to_datetime(monthly_sales[['Year', 'Month']].assign(Day=1))

plt.figure(figsize=(12, 6))
plt.plot(monthly_sales['MonthYear'], monthly_sales['TotalSales'], marker='o', color='blue', label="Monthly Sales")
plt.title('Monthly Sales Trend')
plt.xlabel('Month-Year')
plt.ylabel('Total Sales (₹)')
plt.grid()
plt.legend()
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()

# 2. Top 10 Products by Sales
top_products = df.groupby('Product Name')['TotalSales'].sum().sort_values(ascending=False).head(10)

plt.figure(figsize=(12, 6))
top_products.plot(kind='bar', color='orange')
plt.title('Top 10 Products by Sales')
plt.xlabel('Product Name')
plt.ylabel('Total Sales (₹)')
plt.xticks(rotation=45, ha='right')
plt.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.show()

# 3. Regional Sales Performance
regional_sales = df.groupby('Region')['TotalSales'].sum()

plt.figure(figsize=(8, 8))
regional_sales.plot(kind='pie', autopct='%1.1f%%', startangle=90, colormap='coolwarm')
plt.title('Regional Sales Performance')
plt.ylabel('')
plt.tight_layout()
plt.show()

# Predictive Analytics: Time-Series Forecasting with Improved Linear Regression
df['MonthYear'] = df['Order Date'].dt.to_period('M').astype(str)
time_series = df.groupby('MonthYear')['TotalSales'].sum().reset_index()
time_series['MonthYear'] = pd.to_datetime(time_series['MonthYear'])
time_series['TimeIndex'] = range(len(time_series))

if len(time_series) <= 1:
    raise ValueError("Not enough data for splitting into training and testing sets. Ensure your dataset has multiple months/years.")

X = time_series[['TimeIndex']]
y = time_series['TotalSales']

# Add polynomial features to improve the model's ability to capture non-linear trends
poly = PolynomialFeatures(degree=2, include_bias=False)
X_poly = poly.fit_transform(X)

# Scale the data for better performance of linear regression
scaler = StandardScaler()
X_poly_scaled = scaler.fit_transform(X_poly)

# Split the data into training and testing sets
X_train, X_test, y_train, y_test = train_test_split(X_poly_scaled, y, test_size=0.2, random_state=42)

# Train the improved model
model = LinearRegression()
model.fit(X_train, y_train)

# Make predictions on the testing set
y_pred = model.predict(X_test)


# Forecast future sales (e.g., next 12 months)
future_time_index = pd.DataFrame({'TimeIndex': np.arange(len(time_series), len(time_series) + 12)})
future_time_poly = poly.transform(future_time_index)
future_time_poly_scaled = scaler.transform(future_time_poly)
future_sales = model.predict(future_time_poly_scaled)

# Plot the results
plt.figure(figsize=(10, 6))
plt.plot(time_series['TimeIndex'], time_series['TotalSales'], label='Actual Sales', marker='o')
plt.plot(X_test[:, 0], y_pred, label='Predicted Sales', linestyle='--', marker='x')  # Plot against the original time index
plt.plot(future_time_index['TimeIndex'], future_sales, label='Forecast (Next 12 Months)', linestyle='-.', marker='s')
plt.title('Actual vs Predicted Sales with Improved Model')
plt.xlabel('Time Index')
plt.ylabel('Total Sales (₹)')
plt.legend()
plt.grid()
plt.tight_layout()
plt.show()

# Save the cleaned and transformed data
df.to_csv("cleaned_sales_data_india 1.csv", index=False)
print("\nCleaned and transformed data saved to 'cleaned_sales_data_india.csv'.")

